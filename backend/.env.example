APP_NAME=Waffir
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=UTC

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── PostgreSQL (the ONLY supported application database) ────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=waffir
DB_USERNAME=waffir
DB_PASSWORD=waffir_dev_password

# Feature/integration tests also run against PostgreSQL.
# Create it once with:  createdb -U postgres -O waffir waffir_test
DB_TEST_DATABASE=waffir_test

SESSION_DRIVER=file
QUEUE_CONNECTION=sync
CACHE_STORE=file

# ── Auth / tokens ──────────────────────────────────────────────────────
# Access token lifetime in minutes (Sanctum)
SANCTUM_TOKEN_EXPIRATION=60
# Refresh token lifetime in days
WAFFIR_REFRESH_TOKEN_DAYS=30

# ── OTP ────────────────────────────────────────────────────────────────
WAFFIR_OTP_LENGTH=6
WAFFIR_OTP_TTL_MINUTES=10
WAFFIR_OTP_MAX_ATTEMPTS=5
WAFFIR_OTP_RESEND_COOLDOWN_SECONDS=60
# SMS driver: log (writes the code into storage/logs/laravel.log) | null
WAFFIR_SMS_DRIVER=log
# Fixed development OTP. Honoured ONLY when APP_ENV is local or testing.
OTP_TEST_CODE=123456

# ── Representative (real) price aggregation ────────────────────────────
WAFFIR_PRICE_FRESHNESS_DAYS=30
WAFFIR_PRICE_MAD_THRESHOLD=3.5
WAFFIR_PRICE_MIN_SAMPLES_FOR_FILTER=5

# ── CORS ───────────────────────────────────────────────────────────────
WAFFIR_CORS_ALLOWED_ORIGINS=*
