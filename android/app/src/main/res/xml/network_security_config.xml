<?xml version="1.0" encoding="utf-8"?>
<!--
    Cleartext (plain HTTP) is refused by default on Android 9+, which is what we
    want for anything public. The local Laravel development server does not have
    TLS, so cleartext is permitted for development hosts ONLY:

      127.0.0.1   the host reached through `adb reverse tcp:8000 tcp:8000`
      localhost   same thing by name
      10.0.2.2    the developer machine as seen from the Android emulator

    A physical device on the same Wi-Fi as the backend should either keep using
    `adb reverse` (recommended, nothing to configure) or have its developer LAN
    IP added below. Production traffic must use HTTPS, which this file does not
    affect.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- Developer LAN address used while demonstrating on a real phone. -->
        <domain includeSubdomains="false">192.168.43.110</domain>
    </domain-config>
</network-security-config>
